---
interface Props { post: any; Content: any; }
const { post, Content } = Astro.props;
const d = post.data;
const styles: Record<string, string> = {
  thriving: 'background:var(--lime); color:var(--ink);',
  tense: 'background:var(--pink); color:var(--cream);',
  watching: 'border:2px solid var(--ink); padding:4px 10px;',
};
---
<section class="grid grid-3 rule-b">
  {d.overheard && (
    <div class="cell" style="padding:28px 24px; gap:16px;">
      <span class="label tag" style="border:2px solid var(--purple); color:var(--purple-deep); padding:6px 10px; align-self:flex-start;">Overheard</span>
      <blockquote class="anton" style="font-size:clamp(28px, 3.5vw, 40px); color:var(--purple-deep); line-height:0.95; margin:0;">“{d.overheard.quote}”</blockquote>
      {d.overheard.who && <span style="font-size:13px; font-weight:600; color:var(--ink-muted)">— {d.overheard.who}</span>}
    </div>
  )}
  <div class="cell span2" style={`grid-column: span ${d.overheard ? 2 : 3}; padding:28px 24px; gap:16px;`}>
    <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
      <span class="label tag" style="background:var(--purple); color:var(--cream)">Lead</span>
      <span class="label" style="color:var(--ink-muted)">{d.kicker ?? 'Chemistry'}</span>
    </div>
    {d.image && <figure style="margin:0"><img src={d.image} alt="" style="border:2px solid var(--ink); aspect-ratio:16/9; object-fit:cover;" />{d.imageCredit && <figcaption style="font-size:12px; color:var(--ink-muted); font-weight:600; margin-top:8px;">{d.imageCredit}</figcaption>}</figure>}
    <h1 class="anton" style="font-size:clamp(34px, 4.5vw, 48px); line-height:0.95">{d.title}</h1>
    <div class="prose"><Content /></div>
  </div>
</section>

{d.chemistry.length > 0 && (
  <>
    <div style="padding:24px 24px 0;"><h2 class="anton" style="font-size:40px">Chemistry check</h2></div>
    <section class="grid grid-3 rule-b" style="margin-top:16px; border-top: var(--rule);">
      {d.chemistry.map((c: any) => (
        <div class="cell" style="padding:22px 24px;">
          <span class="label tag" style={`align-self:flex-start; padding:6px 10px; ${styles[c.status]}`}>{c.status}</span>
          <span class="anton" style="font-size:28px">{c.subject}</span>
          {c.note && <span style="font-size:15px;">{c.note}</span>}
        </div>
      ))}
    </section>
  </>
)}

{d.also.length > 0 && (
  <section class="grid grid-2 rule-b">
    {d.also.map((a: any) => (
      <div class="cell" style="gap:10px;">
        <span class="label" style="color:var(--purple-deep)">Also in the chat</span>
        <span class="anton" style="font-size:26px">{a.title}</span>
        {a.body && <p style="margin:0; font-size:15px;">{a.body}</p>}
      </div>
    ))}
  </section>
)}
